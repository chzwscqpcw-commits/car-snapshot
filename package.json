{
  "name": "car-snapshot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npx tsx scripts/fetch-fuel-prices.ts && npx tsx scripts/fetch-how-many-left.ts && npx tsx scripts/build-freshness-manifest.ts && npx tsx scripts/generate-llms-txt.ts && npx tsx scripts/validate-data.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:pdf && npm run test:report-v2 && npm run test:valuation && npm run test:historic && npm run test:booking && npm run test:booking-postcode && npm run test:buyer-flags && npm run test:model-buying && npm run test:model-family && npm run test:redact && npm run test:ebay && npm run test:wbac && npm run test:wrong-turn && npm run test:insurance && npm run test:saved-cars && npm run test:car-alerts && npm run test:mot-areas && npm run test:fixter && npm run test:sample-cars && npm run test:site-index",
    "test:pdf": "npx tsx scripts/test-pdf-report.ts",
    "test:report-v2": "npx tsx scripts/test-report-v2.ts",
    "test:valuation": "npx tsx scripts/test-valuation-lookup.ts",
    "test:historic": "npx tsx scripts/test-historic-vehicle.ts",
    "test:booking": "npx tsx scripts/test-booking-savings.ts",
    "test:booking-postcode": "npx tsx scripts/test-booking-postcode.ts",
    "test:buyer-flags": "npx tsx scripts/test-buyer-flags.ts",
    "test:model-buying": "npx tsx scripts/test-model-buying-checks.ts",
    "test:model-family": "npx tsx scripts/test-model-family.ts",
    "test:redact": "npx tsx scripts/test-redact.ts",
    "test:e2e": "node e2e/plate-flow.mjs",
    "test:ebay": "npx tsx scripts/test-ebay-comparables.ts",
    "test:wbac": "npx tsx scripts/test-wbac-link.ts",
    "test:wrong-turn": "npx tsx scripts/test-wrong-turn-league.ts",
    "test:insurance": "npx tsx scripts/test-insurance.ts",
    "test:saved-cars": "npx tsx scripts/test-saved-cars.ts",
    "test:car-alerts": "npx tsx scripts/test-car-alerts.ts",
    "test:mot-areas": "npx tsx scripts/test-mot-areas.ts",
    "test:fixter": "npx tsx scripts/test-fixter-link.ts",
    "test:sample-cars": "npx tsx scripts/test-sample-cars.ts",
    "test:site-index": "npx tsx scripts/test-site-index.ts",
    "typecheck": "tsc --noEmit",
    "validate-data": "npx tsx scripts/validate-data.ts",
    "check-freshness": "npx tsx scripts/check-freshness.ts",
    "refresh-data": "npx tsx scripts/refresh-data.ts",
    "ping-sitemap": "npx tsx scripts/ping-sitemap.ts",
    "generate-previews": "npx tsx scripts/generate-previews.ts",
    "deploy": "vercel build --prod && vercel deploy --prebuilt --prod --archive=tgz"
  },
  "dependencies": {
    "@react-email/components": "^1.0.8",
    "@react-email/render": "^2.0.4",
    "@sparticuz/chromium": "148.0.0",
    "@supabase/supabase-js": "^2.90.1",
    "@vercel/functions": "^3.9.5",
    "gray-matter": "^4.0.3",
    "jspdf": "^4.0.0",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "puppeteer-core": "25.0.4",
    "qrcode": "1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "resend": "^6.9.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@react-email/preview-server": "^5.2.9",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.23",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "postcss": "^8.5.6",
    "react-email": "^5.2.9",
    "tailwindcss": "^4.1.18",
    "typescript": "^5"
  }
}
